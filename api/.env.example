# Server
PORT=3000
NODE_ENV=development

# PostgreSQL (Railway injects DATABASE_URL automatically when you attach the
# Postgres plugin — copy it here for local dev). Must have PostGIS available;
# run `CREATE EXTENSION IF NOT EXISTS postgis;` once as a superuser if Railway
# doesn't enable it by default for your plan.
DATABASE_URL=postgres://user:password@localhost:5432/conchquest

# Supabase Auth
# Settings > API Keys > Project URL. Access tokens are verified against this
# project's published JWKS (Settings > JWT Keys), not a shared secret.
SUPABASE_URL=https://your-project.supabase.co
# Settings > API Keys > the publishable/anon key (safe to be public -- it's
# also hardcoded client-side in admin/src/lib/supabase.ts). Used server-side
# only so the admin console's cookie-session login/refresh can call
# Supabase's grant endpoints on the browser's behalf.
SUPABASE_ANON_KEY=your-publishable-key

# Browser origins allowed to send cookie-carrying (credentialed) requests --
# comma-separated. Defaults to local dev origins if unset; add the deployed
# admin console's real origin once it has one.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8082

# OpenWeather (free tier: Current Weather + 5 day/3 hour forecast)
OPENWEATHER_API_KEY=your-openweather-api-key

# OpenAI (Shelling Strategy card -- gpt-4o-mini)
OPENAI_API_KEY=your-openai-api-key

# Environmental data caching
# Tuned from the admin console (System Config -> conditions_cache_ttl_minutes),
# not here. Set this only to override it on one machine; it changes nothing
# for anyone else, whereas the app_config value is shared by all of us.
# CONDITIONS_CACHE_TTL_MINUTES=5
STRATEGY_CACHE_TTL_MINUTES=1440
NOAA_STATION_REFRESH_DAYS=7

# Railway Bucket (S3-compatible, private) for find photos.
# Credentials tab on the bucket's service page in the Railway dashboard.
BUCKET_ENDPOINT=https://your-bucket-endpoint
RAILWAY_BUCKET_NAME=your-bucket-name
ACCESS_KEY_ID=your-access-key-id
SECRET_ACCESS_KEY=your-secret-access-key
