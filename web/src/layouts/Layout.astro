---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Conchquest turns tide, wind, and wave data into one shelling forecast for the Gulf Coast." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title} — Conchquest</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --cream: #f8f7f4;
    --ink: #1a1a18;
    --muted: #5f5e5a;
    --teal: #1d9e75;
    --teal-deep: #085041;
    --teal-tint: #e1f5ee;
    --sand: #faeeda;
    --coral: #d85a30;
    --line: #e8e6e0;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  html {
    scroll-behavior: smooth;
    scrollbar-gutter: stable;
  }
  body {
    font-family: 'Inter', sans-serif;
    background: var(--cream);
    color: var(--ink);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  a {
    color: inherit;
  }
  :focus-visible {
    outline: 2px solid var(--teal-deep);
    outline-offset: 2px;
  }
  .wrap {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 32px;
  }

  /* Shared nav, used by every page */
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(248, 247, 244, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 32px;
    max-width: 1080px;
    margin: 0 auto;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: 20px;
    color: var(--ink);
    text-decoration: none;
  }
  .brand-mark {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: var(--teal-tint);
    border: 1px solid #9fe1cb;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 17px;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .nav-links a {
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    color: var(--muted);
  }
  .nav-links a:hover {
    color: var(--ink);
  }

  /* Shared footer */
  footer.site-footer {
    border-top: 1px solid var(--line);
    padding: 40px 0;
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }
  .footer-tag {
    font-size: 13px;
    color: #9b9a92;
  }
  .footer-links {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }
  .footer-links a {
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
  }
  .footer-links a:hover {
    color: var(--ink);
  }
  @media (max-width: 720px) {
    .nav-inner {
      padding: 14px 20px;
    }
    .footer-inner {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
