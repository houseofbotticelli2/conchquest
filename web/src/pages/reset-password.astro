---
import Layout from '../layouts/Layout.astro';
import { ResetPasswordForm } from '../components/ResetPasswordForm';
---

<Layout title="Reset your password">
  <div class="page">
    <div class="nav">
      <a class="brand" href="/"><span class="brand-mark">🐚</span> Conchquest</a>
    </div>

    <div class="stage">
      <ResetPasswordForm client:load />
    </div>

    <footer class="site-footer-simple">© 2026 Conchquest</footer>
  </div>
</Layout>

<style is:global>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  .page .nav {
    position: static;
    background: none;
    backdrop-filter: none;
    border-bottom: none;
    padding: 20px 32px;
  }
  .page .nav .brand {
    width: fit-content;
  }
  .stage {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  .card {
    width: 100%;
    max-width: 400px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 40px 36px;
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.05);
  }
  .card-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--teal-tint);
    border: 1px solid #9fe1cb;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    margin-bottom: 20px;
  }
  .card h1 {
    font-family: 'Fraunces', serif;
    font-size: 26px;
    font-weight: 600;
    margin-bottom: 10px;
    line-height: 1.2;
  }
  .card .sub {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.6;
    margin-bottom: 28px;
  }
  .card .sub strong {
    color: var(--ink);
  }
  .card label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 6px;
  }
  .card .field {
    margin-bottom: 16px;
  }
  .card input {
    width: 100%;
    border: 1px solid var(--line);
    background: var(--cream);
    border-radius: 10px;
    padding: 12px 14px;
    font-size: 14px;
    font-family: 'Inter', sans-serif;
    color: var(--ink);
  }
  .card input:focus {
    outline: none;
    border-color: var(--teal);
    background: #fff;
  }
  .card .hint {
    font-size: 12px;
    color: #9b9a92;
    margin-top: 6px;
  }
  .card .notice {
    font-size: 13px;
    color: #a32d2d;
    margin-bottom: 12px;
    line-height: 1.5;
  }
  .card .btn {
    width: 100%;
    border: none;
    background: var(--teal-deep);
    color: #fff;
    font-weight: 600;
    font-size: 14px;
    padding: 13px;
    border-radius: 10px;
    cursor: pointer;
    margin-top: 8px;
  }
  .card .btn:hover {
    background: var(--ink);
  }
  .card .btn:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .card .btn-secondary {
    width: 100%;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--muted);
    font-weight: 600;
    font-size: 13px;
    padding: 11px;
    border-radius: 10px;
    cursor: pointer;
    margin-top: 10px;
  }
  .card .btn-secondary:hover {
    border-color: #c9c7bf;
    color: var(--ink);
  }
  .card .strength {
    display: flex;
    gap: 4px;
    margin-top: 8px;
  }
  .card .strength span {
    flex: 1;
    height: 4px;
    border-radius: 2px;
    background: var(--line);
  }
  .card .back-link {
    display: block;
    text-align: center;
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
    margin-top: 22px;
  }
  .card .back-link:hover {
    color: var(--ink);
  }
  .card .success-check {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--teal-tint);
    border: 1px solid #9fe1cb;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    color: var(--teal-deep);
    margin-bottom: 20px;
  }
</style>
