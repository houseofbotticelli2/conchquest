---
import Layout from '../layouts/Layout.astro';
import { ResetPasswordForm } from '../components/ResetPasswordForm';
---

<Layout title="Reset Password">
  <h1>Reset your password</h1>
  <ResetPasswordForm client:load />
</Layout>

<style is:global>
  .field {
    margin-bottom: 16px;
  }
  label {
    display: block;
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 4px;
  }
  input {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 6px;
    font-size: 15px;
  }
  button {
    background: var(--accent);
    color: white;
    border: none;
    border-radius: 6px;
    padding: 10px 18px;
    font-size: 15px;
    cursor: pointer;
  }
  button:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .form-error {
    color: #a32d2d;
    font-size: 14px;
  }
</style>
